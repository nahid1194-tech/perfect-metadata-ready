// Adobe Stock Tracker — optional PostgreSQL persistence layer.
//
// The database is OPTIONAL. When DATABASE_URL is not set the app runs
// DB-less: historical observations are kept in a short-lived in-memory store
// and clearly labeled as session-only. When DATABASE_URL is set, `prisma
// migrate deploy` / `prisma db push` creates these tables and the app
// persists assets, creators, observations, and search history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One public Adobe Stock asset (media_id), indexed locally.
model Asset {
  id              Int      @id @default(autoincrement())
  adobeAssetId    String   @unique
  title           String?
  creatorId       String?
  creatorName     String?
  thumbnailUrl    String?
  detailsUrl      String?
  contentType     String?
  width           Int?
  height          Int?
  keywords        Json?
  category        String?
  isTransparent   Boolean?
  isGenerativeAI  Boolean?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  creator         Creator?            @relation(fields: [creatorId], references: [adobeCreatorId])
  observations    AssetObservation[]

  @@index([creatorId])
}

/// A single point-in-time observation of a metric for an asset.
///
/// `availableDownloadMetric` holds an EXACT download count ONLY when the
/// data source actually provides one (e.g. an authorized provider that
/// exposes counts). For the official Adobe Stock API it stays null; the
/// `source` field then records what was actually observed (e.g.
/// "popularity-signal" for the ranking-based percentile) so no estimated
/// value is ever presented as a real count.
model AssetObservation {
  id                      Int      @id @default(autoincrement())
  assetId                 Int
  observedAt              DateTime @default(now())
  availableDownloadMetric Float?
  popularitySignal        Float?
  source                  String
  confidence              Float?

  asset                   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, observedAt])
}

/// One Adobe Stock contributor we have indexed locally.
model Creator {
  id             Int      @id @default(autoincrement())
  adobeCreatorId String   @unique
  creatorName    String?
  portfolioUrl   String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  assets         Asset[]
}

/// Every search performed through the API (query + type + timestamp).
model SearchHistory {
  id         Int      @id @default(autoincrement())
  query      String
  searchType String
  createdAt  DateTime @default(now())

  @@index([searchType, createdAt])
}
